{
	"name": "csd",
	"version": "0.0.0",
	"description": "An unofficial series of tools and resources related to Cheltenham School District",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite dev",
		"extract:policies": "node tools/extract-policies.ts",
		"format": "npm run format:eslint && npm run format:prettier",
		"format:eslint": "eslint . --fix || true",
		"format:prettier": "prettier . --write",
		"lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:svelte-check",
		"lint:eslint": "eslint . --max-warnings=0",
		"lint:prettier": "prettier . --check",
		"lint:svelte-check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/slifty/csd.git"
	},
	"keywords": [
		"cheltenham",
		"school-district",
		"board-policy"
	],
	"author": "Daniel Schultz",
	"license": "AGPL-3.0",
	"engines": {
		"node": "24"
	},
	"devDependencies": {
		"@biffud/eslint-config": "~10.27.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.19.1",
		"@vitest/coverage-v8": "^5.0.3",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.1"
	}
}
