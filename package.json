{
	"name": "csd",
	"version": "0.0.0",
	"description": "An unofficial series of tools and resources related to Cheltenham School District",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "npm run format:eslint && npm run format:prettier",
		"format:eslint": "eslint . --fix || true",
		"format:prettier": "prettier . --write",
		"lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:tsc",
		"lint:eslint": "eslint . --max-warnings=0",
		"lint:prettier": "prettier . --check",
		"lint:tsc": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/slifty/csd.git"
	},
	"keywords": [
		"cheltenham",
		"school-district",
		"board-policy"
	],
	"author": "Daniel Schultz",
	"license": "AGPL-3.0",
	"engines": {
		"node": "24"
	},
	"devDependencies": {
		"@biffud/eslint-config": "~10.27.0",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.19.1",
		"@vitest/coverage-v8": "^5.0.3",
		"eslint": "^10.12.0",
		"prettier": "3.9.9",
		"typescript": "^6.0.3",
		"vitest": "^5.0.1"
	}
}
